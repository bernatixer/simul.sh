+    // machines). If GHOSTTY_XCFRAMEWORK_SKIP=1, install the first library and
+    // its headers directly into zig-out/lib and zig-out/include instead of
+    // wrapping them in an xcframework.
+    if (b.graph.environ_map.get("GHOSTTY_XCFRAMEWORK_SKIP") != null) {
+        const lib = opts.libraries[0];
+        const install_dir = b.addInstallDirectory(.{
+            .source_dir = lib.headers,
+            .install_dir = .{ .custom = "include" },
+            .install_subdir = "",
+            .exclude_extensions = &.{"module.modulemap"},
+        });
+        const install_lib = b.addInstallFileWithDir(lib.library, .{ .custom = "lib" }, "libghostty.a");
+        install_lib.step.dependOn(&install_dir.step);
+        self.* = .{
+            .step = &install_lib.step,
+        };
+        return self;
+    }
