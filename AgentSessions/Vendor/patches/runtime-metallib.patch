 pub fn create(b: *std.Build, opts: Options) ?*MetallibStep {
+    // [AgentSessions patch] Allow avoiding the Xcode Metal toolchain:
+    //  - GHOSTTY_METALLIB_FILE=<path>: use a prebuilt metallib file as-is.
+    //  - GHOSTTY_METALLIB_PLACEHOLDER=1: emit a placeholder metallib and
+    //    compile shaders from source at runtime (see shaders.zig patch).
+    if (b.graph.environ_map.get("GHOSTTY_METALLIB_FILE")) |path| {
+        const self = b.allocator.create(MetallibStep) catch @panic("OOM");
+        self.* = .{
+            .step = b.step("metallib-external", "External prebuilt metallib (AgentSessions)"),
+            .output = .{ .cwd_relative = path },
+        };
+        return self;
+    }
+    if (b.graph.environ_map.get("GHOSTTY_METALLIB_PLACEHOLDER") != null) {
+        const wf = b.addWriteFiles();
+        const out = wf.add(
+            b.fmt("{s}.metallib", .{opts.name}),
+            "AgentSessions placeholder metallib; shaders compiled at runtime",
+        );
+        const self = b.allocator.create(MetallibStep) catch @panic("OOM");
+        self.* = .{
+            .step = &wf.step,
+            .output = out,
+        };
+        return self;
+    }
+
     const sdk = switch (opts.target.result.os.tag) {
         .macos => "macosx",
         else => return null,
