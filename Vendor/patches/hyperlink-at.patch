 /// Returns true if the mouse is currently captured by the terminal
 /// (i.e. reporting events).
+pub fn hyperlinkAt(self: *Surface, x: u16, y: u32) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const screen = self.renderer_state.terminal.screens.active;
+    const pin = screen.pages.pin(.{ .viewport = .{ .x = x, .y = y } }) orelse return false;
+    return pin.rowAndCell().cell.hyperlink;
+}
